<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Nexi.UI.ViewModels"
             xmlns:models="using:Nexi.Data.Models"
             xmlns:material="using:Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Nexi.UI.Views.ModelsView"
             x:CompileBindings="True"
             x:DataType="vm:ModelsViewModel">

  <Grid RowDefinitions="Auto,*,Auto">
    <!-- Header -->
    <Border Grid.Row="0"
            Background="{DynamicResource SystemChromeMediumColor}"
            BoxShadow="0 2 8 0 #30000000">
      <Grid ColumnDefinitions="*,Auto" Margin="32,24">
        <StackPanel Grid.Column="0" Spacing="8">
          <TextBlock Text="AI Models"
                   FontFamily="Cascadia Code"
                   FontSize="32"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource SystemAccentColor}"/>
          <TextBlock Text="Manage your AI models"
                   FontSize="16"
                   Opacity="0.7"/>
        </StackPanel>
        
        <Button Grid.Column="1"
                Command="{CompiledBinding RefreshModelsCommand}"
                ToolTip.Tip="Refresh models"
                Classes="round-button"
                VerticalAlignment="Top">
          <material:MaterialIcon Kind="Refresh" Width="20" Height="20"/>
        </Button>
      </Grid>
    </Border>

    <!-- Models List -->
    <ScrollViewer Grid.Row="1">
      <ItemsControl ItemsSource="{CompiledBinding AvailableModels}"
                   Margin="32">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="16"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ModelItemViewModel">
            <Border Background="{DynamicResource SystemChromeMediumColor}"
                    CornerRadius="12"
                    BoxShadow="0 2 8 0 #30000000">
              <Grid ColumnDefinitions="Auto,*,Auto" Margin="24,20">
                <!-- Icon -->
                <Border Grid.Column="0"
                        Width="48"
                        Height="48"
                        CornerRadius="24"
                        Background="{DynamicResource SystemAccentColor}">
                  <material:MaterialIcon Kind="Brain"
                                       Width="24"
                                       Height="24"
                                       Foreground="White"/>
                </Border>

                <!-- Model Info -->
                <StackPanel Grid.Column="1"
                          Margin="20,0"
                          VerticalAlignment="Center"
                          Spacing="4">
                  <TextBlock Text="{CompiledBinding Name}"
                           FontSize="18"
                           FontWeight="SemiBold"/>
                  <TextBlock Text="{CompiledBinding Description}"
                           FontSize="14"
                           Opacity="0.7"/>
                  <StackPanel Orientation="Horizontal"
                            Spacing="16"
                            Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <material:MaterialIcon Kind="Database"
                                           Opacity="0.7"/>
                      <TextBlock Text="{CompiledBinding Size}"
                               Opacity="0.7"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <material:MaterialIcon Kind="Tag"
                                           Opacity="0.7"/>
                      <TextBlock Text="{CompiledBinding Version}"
                               Opacity="0.7"/>
                    </StackPanel>
                  </StackPanel>
                  
                  <!-- Progress Bar (only visible when downloading) -->
                  <ProgressBar Value="{CompiledBinding DownloadProgress}"
                             IsVisible="{CompiledBinding IsDownloading}"
                             Maximum="1.0"
                             Height="4"
                             Margin="0,8,0,0"/>
                </StackPanel>

                <!-- Actions -->
                <StackPanel Grid.Column="2"
                          Spacing="8"
                          VerticalAlignment="Center">
                  <!-- Status Badge -->
                  <Border Background="{CompiledBinding Status, Converter={StaticResource ModelStatusToBrushConverter}}"
                          CornerRadius="20"
                          Padding="16,8"
                          HorizontalAlignment="Right">
                    <TextBlock Text="{CompiledBinding Status}"
                             FontSize="14"
                             Foreground="White"/>
                  </Border>
                  
                  <!-- Action Buttons -->
                  <StackPanel Orientation="Horizontal" 
                            Spacing="8"
                            HorizontalAlignment="Right"
                            Margin="0,8,0,0">
                    <!-- Download Button - only shown for NotDownloaded models -->
                    <Button Command="{CompiledBinding $parent[ItemsControl].((vm:ModelsViewModel)DataContext).DownloadModelCommand}"
                            CommandParameter="{CompiledBinding Id}"
                            Classes="action-button"
                            IsVisible="{CompiledBinding Status, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:ModelStatus.NotDownloaded}}">
                      <material:MaterialIcon Kind="Download"/>
                    </Button>
                    
                    <!-- Delete Button - only shown for Downloaded models -->
                    <Button Command="{CompiledBinding $parent[ItemsControl].((vm:ModelsViewModel)DataContext).DeleteModelCommand}"
                            CommandParameter="{CompiledBinding Id}"
                            Classes="action-button"
                            IsVisible="{CompiledBinding Status, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:ModelStatus.Downloaded}}">
                      <material:MaterialIcon Kind="Delete"/>
                    </Button>
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    
    <!-- Status Bar -->
    <Border Grid.Row="2"
            Background="{DynamicResource SystemChromeMediumColor}"
            Height="36">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <material:MaterialIcon Grid.Column="0"
                             Kind="Information"
                             Margin="10,0,0,0"
                             VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1"
                 Text="{CompiledBinding StatusMessage}"
                 Margin="8,0,0,0"
                 VerticalAlignment="Center"/>
        <ProgressBar Grid.Column="2"
                   IsIndeterminate="True"
                   Width="100"
                   Height="2"
                   Margin="0,0,10,0"
                   IsVisible="{CompiledBinding IsLoading}"/>
      </Grid>
    </Border>
  </Grid>

  <UserControl.Styles>
    <Style Selector="Button.round-button">
      <Setter Property="Width" Value="40"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="CornerRadius" Value="20"/>
      <Setter Property="Background" Value="{DynamicResource SystemAccentColor}"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    
    <Style Selector="Button.action-button">
      <Setter Property="Width" Value="36"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="CornerRadius" Value="18"/>
      <Setter Property="Background" Value="{DynamicResource SystemAccentColorDark1}"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    
    <Style Selector="material|MaterialIcon">
      <Setter Property="Width" Value="20"/>
      <Setter Property="Height" Value="20"/>
    </Style>
    
    <Style Selector="ProgressBar">
      <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}"/>
    </Style>
  </UserControl.Styles>
</UserControl>
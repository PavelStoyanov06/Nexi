<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:material="using:Material.Icons.Avalonia"
             xmlns:vm="using:Nexi.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Nexi.UI.Views.ModelsView"
             x:CompileBindings="False"
             Name="ModelsViewControl">

  <UserControl.Resources>
    <SolidColorBrush x:Key="DownloadingBrush" Color="#3498db"/>
    <SolidColorBrush x:Key="DownloadedBrush" Color="#2ecc71"/>
    <SolidColorBrush x:Key="NotDownloadedBrush" Color="#e74c3c"/>
  </UserControl.Resources>

  <Grid RowDefinitions="Auto,*">
    <!-- Header -->
    <Border Grid.Row="0"
            Background="{DynamicResource SystemChromeMediumColor}"
            BoxShadow="0 2 8 0 #30000000">
      <Grid ColumnDefinitions="*,Auto" Margin="32,24">
        <StackPanel Grid.Column="0" Spacing="8">
          <TextBlock Text="GGUF Models"
                   FontFamily="Cascadia Code"
                   FontSize="32"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource SystemAccentColor}"/>
          <TextBlock Text="Download and manage GGUF models for LlamaSharp"
                   FontSize="16"
                   Opacity="0.7"/>
        </StackPanel>
        <Button Grid.Column="1"
                Command="{Binding RefreshModelsCommand}"
                Classes="TransparentButton"
                ToolTip.Tip="Refresh Model Status">
          <material:MaterialIcon Kind="Refresh" Width="24" Height="24"/>
        </Button>
      </Grid>
    </Border>

    <!-- Content Area -->
    <ScrollViewer Grid.Row="1">
      <StackPanel Margin="32">
        <!-- Status Messages -->
        <Border Background="#FFDDDD"
                BorderBrush="#FF5555"
                BorderThickness="1"
                CornerRadius="4"
                Padding="16"
                Margin="0,0,0,16"
                IsVisible="{Binding HasError}">
          <TextBlock Text="{Binding ErrorMessage}"
                   Foreground="#CC0000"
                   TextWrapping="Wrap"/>
        </Border>
        
        <Border Background="#DDFFDD"
                BorderBrush="#55AA55"
                BorderThickness="1"
                CornerRadius="4"
                Padding="16"
                Margin="0,0,0,16"
                IsVisible="{Binding HasStatusMessage}">
          <TextBlock Text="{Binding StatusMessage}"
                   Foreground="#006600"
                   TextWrapping="Wrap"/>
        </Border>
        
        <!-- Loading Indicator -->
        <ProgressBar IsIndeterminate="True"
                   Margin="0,0,0,16"
                   Height="4"
                   IsVisible="{Binding IsLoading}"/>
        
        <!-- Model Cards -->
        <ItemsControl ItemsSource="{Binding PredefinedModels}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="{DynamicResource SystemChromeMediumColor}"
                      CornerRadius="12"
                      BoxShadow="0 2 8 0 #30000000"
                      Margin="0,0,0,16"
                      Padding="20">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                  <!-- Model Name -->
                  <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="{Binding Name}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>
                  
                  <!-- Model Info -->
                  <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="16" Margin="0,0,0,8">
                    <TextBlock Text="{Binding Size}" Opacity="0.7"/>
                    <TextBlock Text="{Binding Quantization}" Foreground="{DynamicResource SystemAccentColor}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Border Width="12" 
                              Height="12" 
                              Background="{Binding StatusBrush}"
                              CornerRadius="6"
                              VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding Status}" Opacity="0.7"/>
                    </StackPanel>
                  </StackPanel>
                  
                  <!-- Model Description -->
                  <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                           Text="{Binding Description}"
                           TextWrapping="Wrap"
                           Opacity="0.7"
                           Margin="0,0,0,16"/>
                  
                  <!-- Download Progress -->
                  <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                            IsVisible="{Binding IsDownloading}">
                    <TextBlock Text="Downloading..." 
                             Margin="0,0,0,8" 
                             FontWeight="SemiBold" 
                             Foreground="{DynamicResource SystemAccentColor}"/>
                    <Grid ColumnDefinitions="*,Auto">
                      <ProgressBar Grid.Column="0" Value="{Binding Progress}" 
                                 Maximum="100"
                                 Height="8" 
                                 Foreground="{DynamicResource SystemAccentColor}"/>
                      <Button Grid.Column="1"
                            Command="{Binding DataContext.CancelDownloadCommand, ElementName=ModelsViewControl}"
                            CommandParameter="{Binding}"
                            Content="Cancel"
                            Margin="8,0,0,0"
                            Classes="DangerButton"/>
                    </Grid>
                    <TextBlock Text="{Binding ProgressText}" 
                             HorizontalAlignment="Right" 
                             Margin="0,4,0,0"
                             FontSize="12"/>
                  </StackPanel>
                  
                  <!-- Action Buttons -->
                  <StackPanel Grid.Row="3" Grid.Column="1" 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Right"
                            Spacing="8">
                    <Button Command="{Binding DataContext.DownloadModelCommand, ElementName=ModelsViewControl}"
                          CommandParameter="{Binding}"
                          Content="Download"
                          Classes="AccentButton"
                          IsVisible="{Binding CanDownload}"/>
                    <Button Command="{Binding DataContext.DeleteModelCommand, ElementName=ModelsViewControl}"
                          CommandParameter="{Binding}"
                          Content="Delete"
                          IsVisible="{Binding IsDownloaded}"/>
                    <Button Command="{Binding DataContext.SelectModelCommand, ElementName=ModelsViewControl}"
                          CommandParameter="{Binding}"
                          Content="Select"
                          Classes="AccentButton"
                          IsVisible="{Binding IsDownloaded}"/>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </Grid>
  
  <UserControl.Styles>
    <Style Selector="Button.AccentButton">
      <Setter Property="Background" Value="{DynamicResource SystemAccentColor}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="CornerRadius" Value="4"/>
    </Style>
    
    <Style Selector="Button.DangerButton">
      <Setter Property="Background" Value="#e74c3c"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="CornerRadius" Value="4"/>
    </Style>
    
    <Style Selector="Button.DangerButton:pointerover">
      <Setter Property="Background" Value="#c0392b"/>
    </Style>
  </UserControl.Styles>
</UserControl>
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Nexi.UI.ViewModels"
             xmlns:models="using:Nexi.Data.Models"
             xmlns:material="using:Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Nexi.UI.Views.ModelsView"
             x:CompileBindings="True"
             x:DataType="vm:ModelsViewModel">

  <Grid RowDefinitions="Auto,*,Auto">
    <!-- Header -->
    <Border Grid.Row="0"
            Background="{DynamicResource SystemChromeMediumColor}"
            BoxShadow="0 2 8 0 #30000000">
      <Grid ColumnDefinitions="*,Auto" Margin="32,24">
        <StackPanel Grid.Column="0" Spacing="8">
          <TextBlock Text="AI Models"
                   FontFamily="Cascadia Code"
                   FontSize="32"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource SystemAccentColor}"/>
          <TextBlock Text="Manage your AI models - all completely free and open-source"
                   FontSize="16"
                   Opacity="0.7"/>
        </StackPanel>

        <Button Grid.Column="1"
                Command="{CompiledBinding RefreshModelsCommand}"
                ToolTip.Tip="Refresh models"
                Classes="round-button"
                VerticalAlignment="Top">
          <material:MaterialIcon Kind="Refresh" Width="20" Height="20"/>
        </Button>
      </Grid>
    </Border>

    <!-- Content Area with Filter Bar and Models List -->
    <Grid Grid.Row="1" RowDefinitions="Auto,*">
      <!-- Filter Bar -->
      <Border Grid.Row="0"
              Background="{DynamicResource SystemChromeLowColor}"
              Padding="32,12">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
          <!-- Category Filter -->
          <ComboBox Grid.Column="0"
                    ItemsSource="{CompiledBinding Categories}"
                    SelectedItem="{CompiledBinding SelectedCategory}"
                    Width="150"
                    Margin="0,0,16,0"
                    ToolTip.Tip="Filter by model category"/>

          <!-- Search Box -->
          <TextBox Grid.Column="1"
                   Text="{CompiledBinding SearchQuery}"
                   Watermark="Search models..."
                   Margin="0,0,16,0">
            <TextBox.InnerLeftContent>
              <material:MaterialIcon Kind="Magnify"
                                     Margin="8,0,0,0"
                                     Width="16"
                                     Height="16"/>
            </TextBox.InnerLeftContent>
            <TextBox.InnerRightContent>
              <Button Command="{CompiledBinding ClearSearchCommand}"
                      IsVisible="{CompiledBinding !!SearchQuery}"
                      Width="30"
                      Height="30"
                      Background="Transparent"
                      Margin="0,0,4,0">
                <material:MaterialIcon Kind="Close" Width="16" Height="16"/>
              </Button>
            </TextBox.InnerRightContent>
          </TextBox>

          <!-- Show Only Downloaded Toggle -->
          <ToggleButton Grid.Column="2"
                        IsChecked="{CompiledBinding ShowOnlyDownloaded}"
                        Content="Show Installed"
                        Margin="0,0,16,0"
                        Width="130"
                        ToolTip.Tip="Show only installed models"/>

          <!-- Refresh Button -->
          <Button Grid.Column="3"
                  Command="{CompiledBinding RefreshModelsCommand}"
                  Content="Refresh"
                  Width="80"/>
        </Grid>
      </Border>

      <!-- Models List -->
      <ScrollViewer Grid.Row="1">
        <ItemsControl ItemsSource="{CompiledBinding FilteredModels}"
                      Margin="32,16">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ModelItemViewModel">
              <Border Background="{DynamicResource SystemChromeMediumColor}"
                      CornerRadius="12"
                      BoxShadow="0 2 8 0 #30000000"
                      Width="360"
                      Margin="0,0,16,16">
                <Grid RowDefinitions="Auto,*,Auto">
                  <!-- Header with Category Badge -->
                  <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="24,16,24,0">
                    <Border Grid.Column="0"
                            Background="{CompiledBinding BackgroundColor}"
                            CornerRadius="12"
                            Padding="12,6"
                            HorizontalAlignment="Left">
                      <TextBlock Text="{CompiledBinding Category}"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="White"/>
                    </Border>

                    <!-- Status Badge -->
                    <Border Grid.Column="1"
                            Background="{CompiledBinding Status, Converter={StaticResource ModelStatusToBrushConverter}}"
                            CornerRadius="12"
                            Padding="12,6">
                      <TextBlock Text="{CompiledBinding StatusText}"
                                FontSize="14"
                                Foreground="White"/>
                    </Border>
                  </Grid>

                  <!-- Main Content -->
                  <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto,Auto" Margin="24,16">
                    <!-- Icon and Name -->
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,12">
                      <Border Grid.Column="0"
                              Width="48"
                              Height="48"
                              CornerRadius="24"
                              Background="{CompiledBinding BackgroundColor}">
                        <material:MaterialIcon Kind="Brain"
                                               Width="24"
                                               Height="24"
                                               Foreground="White"/>
                      </Border>

                      <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{CompiledBinding Name}"
                                   FontSize="18"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{CompiledBinding Size}"
                                   FontSize="14"
                                   Opacity="0.7"/>
                      </StackPanel>
                    </Grid>

                    <!-- Description -->
                    <TextBlock Grid.Row="1"
                               Text="{CompiledBinding Description}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"/>

                    <!-- Supported Tasks -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
                      <TextBlock Text="Capabilities: " FontWeight="SemiBold"/>
                      <TextBlock Text="{CompiledBinding TasksDisplay}" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Version Info -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="16">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <material:MaterialIcon Kind="Tag"
                                               Opacity="0.7"/>
                        <TextBlock Text="{CompiledBinding Version}"
                                   Opacity="0.7"/>
                      </StackPanel>
                    </StackPanel>

                    <!-- Progress Bar (only visible when downloading) -->
                    <ProgressBar Grid.Row="4"
                                 Value="{CompiledBinding DownloadProgress}"
                                 IsVisible="{CompiledBinding IsDownloading}"
                                 Maximum="1.0"
                                 Height="4"
                                 Margin="0,16,0,0"/>
                  </Grid>

                  <!-- Actions Footer -->
                  <Border Grid.Row="2"
                          Background="{DynamicResource SystemChromeLowColor}"
                          Padding="24,12"
                          CornerRadius="0,0,12,12">
                    <Grid ColumnDefinitions="*,Auto">
                      <!-- Info Text -->
                      <TextBlock Grid.Column="0"
                                 Text="{CompiledBinding StatusText}"
                                 VerticalAlignment="Center"/>

                      <!-- Action Buttons -->
                      <StackPanel Grid.Column="1"
                                 Orientation="Horizontal"
                                 Spacing="8">
                        <!-- Download Button - only shown for NotDownloaded models -->
                        <Button Command="{CompiledBinding $parent[ItemsControl].((vm:ModelsViewModel)DataContext).DownloadModelCommand}"
                                CommandParameter="{CompiledBinding Id}"
                                Content="Download"
                                Classes="accent-button"
                                IsVisible="{CompiledBinding Status, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:ModelStatus.NotDownloaded}}"/>

                        <!-- Delete Button - only shown for Downloaded models -->
                        <Button Command="{CompiledBinding $parent[ItemsControl].((vm:ModelsViewModel)DataContext).DeleteModelCommand}"
                                CommandParameter="{CompiledBinding Id}"
                                Content="Remove"
                                Classes="danger-button"
                                IsVisible="{CompiledBinding Status, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:ModelStatus.Downloaded}}"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>

    <!-- Status Bar -->
    <Border Grid.Row="2"
            Background="{DynamicResource SystemChromeMediumColor}"
            Height="36">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <material:MaterialIcon Grid.Column="0"
                             Kind="Information"
                             Margin="10,0,0,0"
                             VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1"
                 Text="{CompiledBinding StatusMessage}"
                 Margin="8,0,0,0"
                 VerticalAlignment="Center"/>
        <ProgressBar Grid.Column="2"
                   IsIndeterminate="True"
                   Width="100"
                   Height="2"
                   Margin="0,0,10,0"
                   IsVisible="{CompiledBinding IsLoading}"/>
      </Grid>
    </Border>
  </Grid>

  <UserControl.Styles>
    <Style Selector="Button.round-button">
      <Setter Property="Width" Value="40"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="CornerRadius" Value="20"/>
      <Setter Property="Background" Value="{DynamicResource SystemAccentColor}"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style Selector="Button.accent-button">
      <Setter Property="Background" Value="{DynamicResource SystemAccentColor}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="CornerRadius" Value="4"/>
    </Style>

    <Style Selector="Button.danger-button">
      <Setter Property="Background" Value="#E53935"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="CornerRadius" Value="4"/>
    </Style>

    <Style Selector="material|MaterialIcon">
      <Setter Property="Width" Value="20"/>
      <Setter Property="Height" Value="20"/>
    </Style>

    <Style Selector="ProgressBar">
      <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}"/>
    </Style>

    <Style Selector="ToggleButton">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}"/>
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="CornerRadius" Value="4"/>
    </Style>

    <Style Selector="ToggleButton:checked">
      <Setter Property="Background" Value="{DynamicResource SystemAccentColorLight1}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorDark1}"/>
    </Style>
  </UserControl.Styles>
</UserControl>
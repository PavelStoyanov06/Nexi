<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Nexi.UI.ViewModels"
             xmlns:models="using:Nexi.UI.Models"
             xmlns:material="using:Material.Icons.Avalonia"
             xmlns:converters="using:Nexi.UI.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Nexi.UI.Views.ChatView"
             x:CompileBindings="True"
             x:DataType="vm:ChatViewModel">

  <UserControl.Resources>
    <converters:BoolToAlignmentConverter x:Key="BoolToAlignmentConverter" />
    <converters:BoolToBackgroundConverter x:Key="BoolToBackgroundConverter" />
    <converters:BoolToForegroundConverter x:Key="BoolToForegroundConverter" />
    <converters:BoolToSystemMessageBackgroundConverter x:Key="BoolToSystemMessageBackgroundConverter" />
    <converters:BoolToSystemMessageForegroundConverter x:Key="BoolToSystemMessageForegroundConverter" />
  </UserControl.Resources>

  <Grid RowDefinitions="*,Auto">
    <!-- Messages Area -->
    <ScrollViewer Grid.Row="0"
                 Name="MessagesScroll"
                 Background="{DynamicResource SystemChromeMediumColor}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Command Instructions Panel -->
        <Border Grid.Row="0"
                Margin="20,20,20,0"
                Padding="16"
                CornerRadius="8"
                Background="#1E1A33"
                BoxShadow="0 2 8 0 #30000000"
                IsVisible="{CompiledBinding ShowCommandInstructions}">
          <StackPanel>
            <Grid>
              <TextBlock Text="Command Reference" 
                         FontWeight="Bold" 
                         FontSize="16" 
                         Foreground="#B388FF"
                         Margin="0,0,0,8"/>
              <Button HorizontalAlignment="Right"
                      Background="Transparent"
                      Padding="4"
                      Command="{CompiledBinding ToggleCommandInstructionsCommand}"
                      CommandParameter="False">
                <material:MaterialIcon Kind="Close" Width="16" Height="16" Foreground="#B388FF"/>
              </Button>
            </Grid>
            
            <TextBlock Text="Nexi now supports web search and document creation!" 
                       Foreground="White" 
                       FontWeight="SemiBold"
                       Margin="0,0,0,8"/>
                       
            <Expander Header="Web Search Commands" 
                      Foreground="#B388FF" 
                      IsExpanded="True"
                      Margin="0,4">
              <TextBlock TextWrapping="Wrap" Foreground="White" Margin="8,8,0,0">
                <Run Text="• /search [query] - Search the web and open in browser"/>
                <LineBreak/>
                <Run Text="• /search in chat [query] - Show search results in chat"/>
                <LineBreak/>
                <Run Text="• /open url [url] - Open a URL in browser"/>
              </TextBlock>
            </Expander>
            
            <Expander Header="Document Commands" 
                      Foreground="#B388FF"
                      Margin="0,4">
              <TextBlock TextWrapping="Wrap" Foreground="White" Margin="8,8,0,0">
                <Run Text="• /create text [filename] - Create a text file"/>
                <LineBreak/>
                <Run Text="• /create document [filename] - Create a Word document"/>
                <LineBreak/>
                <LineBreak/>
                <Run Text="AI-Assisted Document Creation:"/>
                <LineBreak/>
                <Run Text="Ask the AI to create content, then use the commands above to save the AI's response to a file automatically."/>
                <LineBreak/>
                <Run Text="Example: Ask 'Write a poem about nature' then use '/create text MyPoem'"/>
              </TextBlock>
            </Expander>
            
            <Expander Header="Window Control Commands" 
                      Foreground="#B388FF"
                      Margin="0,4">
              <TextBlock TextWrapping="Wrap" Foreground="White" Margin="8,8,0,0">
                <Run Text="• /minimize - Minimize active window"/>
                <LineBreak/>
                <Run Text="• /maximize - Maximize active window"/>
                <LineBreak/>
                <Run Text="• /restore - Restore active window"/>
              </TextBlock>
            </Expander>
            
            <Expander Header="Other Commands" 
                      Foreground="#B388FF"
                      Margin="0,4">
              <TextBlock TextWrapping="Wrap" Foreground="White" Margin="8,8,0,0">
                <Run Text="• /help - Show all available commands"/>
                <LineBreak/>
                <Run Text="• /time - Show current time"/>
                <LineBreak/>
                <Run Text="• /open calculator - Open calculator app"/>
                <LineBreak/>
                <Run Text="• /open browser - Open default web browser"/>
              </TextBlock>
            </Expander>
            
            <TextBlock Text="Tip: You can use these commands with or without the '/' prefix." 
                       Foreground="#D8C7FF" 
                       FontStyle="Italic"
                       Margin="0,8,0,0"/>
          </StackPanel>
        </Border>
        
        <!-- Messages List -->
        <ItemsControl Grid.Row="1" ItemsSource="{CompiledBinding Messages}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="16" Margin="20"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:ChatMessage">
              <Border Padding="16"
                      CornerRadius="20,20,20,4"
                      BoxShadow="0 2 8 0 #30000000"
                      Background="{CompiledBinding IsUser, Converter={StaticResource BoolToBackgroundConverter}, ConverterParameter={StaticResource SystemAccentColor}, FallbackValue=#1A1A1A}"
                      Classes.system-message="{CompiledBinding IsSystemMessage}"
                      HorizontalAlignment="{CompiledBinding IsUser, Converter={StaticResource BoolToAlignmentConverter}}"
                      MaxWidth="600">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  
                  <StackPanel Grid.Row="0">
                    <TextBlock Text="{CompiledBinding Content}"
                             TextWrapping="Wrap"
                             FontSize="14"
                             Foreground="White"/>
                    <TextBlock Text="{CompiledBinding Timestamp, StringFormat=\{0:t\}}"
                             FontSize="11"
                             Margin="0,8,0,0"
                             HorizontalAlignment="Right"
                             Foreground="White"/>
                  </StackPanel>
                  
                  <!-- Copy Button (only for AI messages) -->
                  <Button Grid.Row="1"
                          Classes="copy-button"
                          HorizontalAlignment="Right"
                          Margin="0,8,0,0"
                          Padding="8,4"
                          Background="#33B388FF"
                          CornerRadius="4"
                          IsVisible="{CompiledBinding !IsUser}"
                          Command="{CompiledBinding $parent[ItemsControl].((vm:ChatViewModel)DataContext).CopyToClipboardCommand}"
                          CommandParameter="{CompiledBinding Content}"
                          ToolTip.Tip="Copy to clipboard">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <material:MaterialIcon Kind="ContentCopy" Width="14" Height="14"/>
                      <TextBlock Text="Copy" FontSize="12"/>
                    </StackPanel>
                  </Button>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </ScrollViewer>

    <!-- Input Area -->
    <Border Grid.Row="1"
            Background="{DynamicResource SystemChromeMediumLowColor}"
            BorderBrush="{DynamicResource SystemAccentColor}"
            BorderThickness="0,1,0,0"
            BoxShadow="0 -4 8 0 #20000000">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto"
            Margin="20">
        <!-- Voice Toggle -->
        <Border Grid.Column="0"
                CornerRadius="20"
                Background="Transparent">
          <ToggleButton Width="40"
                      Height="40"
                      CornerRadius="20"
                      BorderBrush="{DynamicResource SystemAccentColor}"
                      BorderThickness="1.5"
                      VerticalContentAlignment="Center"
                      HorizontalContentAlignment="Center"
                      IsChecked="{CompiledBinding IsVoiceModeEnabled}">
            <material:MaterialIcon Kind="Microphone" Width="20" Height="20"/>
          </ToggleButton>
        </Border>
        
        <!-- Help Toggle -->
        <Border Grid.Column="1"
                CornerRadius="20"
                Background="Transparent"
                Margin="8,0,0,0">
          <Button Width="40"
                  Height="40"
                  CornerRadius="20"
                  BorderBrush="{DynamicResource SystemAccentColor}"
                  BorderThickness="1.5"
                  VerticalContentAlignment="Center"
                  HorizontalContentAlignment="Center"
                  Command="{CompiledBinding ToggleCommandInstructionsCommand}"
                  CommandParameter="{CompiledBinding !ShowCommandInstructions}"
                  ToolTip.Tip="Show command reference">
            <material:MaterialIcon Kind="HelpCircleOutline" Width="20" Height="20"/>
          </Button>
        </Border>

        <!-- Text Input -->
        <TextBox Grid.Column="2"
                Text="{CompiledBinding CurrentMessage}"
                Watermark="Type a message..."
                Height="40"
                CornerRadius="20"
                BorderThickness="1.5"
                BorderBrush="{DynamicResource SystemAccentColor}"
                VerticalContentAlignment="Center"
                Margin="16,0"/>

        <!-- Clear Button -->
        <Border Grid.Column="3"
                CornerRadius="20"
                Background="Transparent"
                IsVisible="{CompiledBinding HasMessageText}">
          <Button Width="40"
                  Height="40"
                  CornerRadius="20"
                  VerticalContentAlignment="Center"
                  HorizontalContentAlignment="Center"
                  Command="{CompiledBinding ClearMessageCommand}">
            <material:MaterialIcon Kind="Close" Width="20" Height="20"/>
          </Button>
        </Border>

        <!-- Send Button -->
        <Button Grid.Column="4"
                Width="40"
                Height="40"
                CornerRadius="20"
                Margin="8,0,0,0"
                Classes="send-button"
                Background="{DynamicResource SystemAccentColor}"
                Command="{CompiledBinding SendMessageCommand}"
                IsEnabled="{CompiledBinding HasMessageText}">
          <material:MaterialIcon Kind="Send" Width="20" Height="20" Foreground="White"/>
        </Button>
      </Grid>
    </Border>
  </Grid>

  <UserControl.Styles>
    <!-- Send Button -->
    <Style Selector="Button.send-button">
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2"/>
          <BrushTransition Property="Background" Duration="0:0:0.2"/>
        </Transitions>
      </Setter>
      <Setter Property="RenderTransform" Value="none"/>
    </Style>

    <Style Selector="Button.send-button:pointerover">
      <Setter Property="RenderTransform" Value="scale(1.1)"/>
      <Setter Property="Background" Value="{DynamicResource SystemAccentColorDark1}"/>
    </Style>

    <!-- Voice Toggle -->
    <Style Selector="ToggleButton">
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2"/>
          <BrushTransition Property="Background" Duration="0:0:0.2"/>
        </Transitions>
      </Setter>
      <Setter Property="RenderTransform" Value="none"/>
    </Style>

    <Style Selector="ToggleButton:pointerover">
      <Setter Property="RenderTransform" Value="scale(1.1)"/>
    </Style>

    <!-- Clear Button -->
    <Style Selector="Button:not(.send-button)">
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2"/>
        </Transitions>
      </Setter>
      <Setter Property="RenderTransform" Value="none"/>
    </Style>

    <Style Selector="Button:not(.send-button):pointerover">
      <Setter Property="RenderTransform" Value="scale(1.1)"/>
    </Style>

    <!-- Message Animation -->
    <Style Selector="Border.message">
      <Setter Property="Opacity" Value="0"/>
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.3"/>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.3"/>
        </Transitions>
      </Setter>
      <Setter Property="RenderTransform" Value="translateY(20px)"/>
    </Style>

    <Style Selector="Border.message.show">
      <Setter Property="Opacity" Value="1"/>
      <Setter Property="RenderTransform" Value="none"/>
    </Style>

    <!-- TextBox Animation -->
    <Style Selector="TextBox">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="TextBox:focus">
      <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}"/>
    </Style>
    
    <!-- Force all text to be white -->
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="White"/>
    </Style>
    
    <!-- System message style -->
    <Style Selector="Border.system-message">
      <Setter Property="Background" Value="#1E1A33"/>
    </Style>
    
    <!-- System message text style -->
    <Style Selector="Border.system-message TextBlock">
      <Setter Property="Foreground" Value="#B388FF"/>
    </Style>
    
    <!-- Copy button style -->
    <Style Selector="Button.copy-button">
      <Setter Property="Opacity" Value="0.5"/>
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
          <BrushTransition Property="Background" Duration="0:0:0.2"/>
        </Transitions>
      </Setter>
    </Style>
    
    <Style Selector="Button.copy-button:pointerover">
      <Setter Property="Opacity" Value="1"/>
      <Setter Property="Background" Value="#66B388FF"/>
    </Style>
  </UserControl.Styles>
</UserControl>
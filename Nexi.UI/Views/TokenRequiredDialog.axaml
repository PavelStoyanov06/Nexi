<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Nexi.UI.ViewModels"
        xmlns:material="using:Material.Icons.Avalonia"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="350"
        x:Class="Nexi.UI.Views.TokenRequiredDialog"
        x:CompileBindings="True"
        x:DataType="vm:TokenRequiredViewModel"
        Title="Authentication Required"
        Width="500"
        Height="350"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SystemChromeMediumColor}">

  <Grid RowDefinitions="Auto,*,Auto" Margin="20">
    <!-- Header -->
    <StackPanel Grid.Row="0" Spacing="12" Margin="0,0,0,16">
      <material:MaterialIcon Kind="ShieldLock"
                           Width="32"
                           Height="32"
                           Foreground="{DynamicResource SystemAccentColor}"/>
      <TextBlock Text="Authentication Required"
               FontSize="24"
               FontWeight="SemiBold"/>
      <TextBlock Text="{CompiledBinding ExplanationText}"
               TextWrapping="Wrap"/>
    </StackPanel>

    <!-- Token Input -->
    <StackPanel Grid.Row="1" Spacing="8" VerticalAlignment="Center">
      <TextBlock Text="HuggingFace Access Token:" FontWeight="SemiBold"/>
      <Grid ColumnDefinitions="*,Auto">
        <TextBox Grid.Column="0"
               PasswordChar="•"
               Text="{CompiledBinding Token}"
               Watermark="Enter your token here"/>
        <ToggleButton Grid.Column="1"
                    Margin="8,0,0,0"
                    IsChecked="{CompiledBinding ShowToken}"
                    ToolTip.Tip="Show/Hide Token">
          <material:MaterialIcon Kind="{CompiledBinding ShowToken, Converter={StaticResource BoolToVisibilityIconConverter}}"/>
        </ToggleButton>
      </Grid>

      <CheckBox Content="Save token for future downloads"
              IsChecked="{CompiledBinding SaveToken}"
              Margin="0,8,0,0"/>

      <Button Content="Get a HuggingFace token"
            Command="{CompiledBinding OpenHuggingFaceTokenPageCommand}"
            Classes="hyperlink-button"
            Margin="0,8,0,0"/>

      <TextBlock Text="{CompiledBinding StatusMessage}"
               Foreground="{CompiledBinding StatusIsError, Converter={StaticResource BoolToErrorBrushConverter}}"
               Margin="0,8,0,0"
               TextWrapping="Wrap"/>
    </StackPanel>

    <!-- Buttons -->
    <StackPanel Grid.Row="2"
              Orientation="Horizontal"
              HorizontalAlignment="Right"
              Spacing="8"
              Margin="0,16,0,0">
      <Button Content="Cancel"
            Command="{CompiledBinding CancelCommand}"
            Width="80"/>
      <Button Content="Continue"
            Command="{CompiledBinding ContinueCommand}"
            Classes="accent-button"
            IsEnabled="{CompiledBinding CanContinue}"
            Width="80"/>
    </StackPanel>
  </Grid>

  <Window.Styles>
    <Style Selector="Button.hyperlink-button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style Selector="Button.hyperlink-button:pointerover /template/ ContentPresenter">
      <Setter Property="TextBlock.TextDecorations" Value="Underline"/>
      <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style Selector="Button.accent-button">
      <Setter Property="Background" Value="{DynamicResource SystemAccentColor}"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
  </Window.Styles>
</Window>
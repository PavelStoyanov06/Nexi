<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Nexi.UI.ViewModels"
             xmlns:models="using:Nexi.UI.Models"
             xmlns:material="using:Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Nexi.UI.Views.SettingsView"
             x:CompileBindings="True"
             x:DataType="vm:SettingsViewModel">

  <Grid RowDefinitions="Auto,*">
    <!-- Header -->
    <Border Grid.Row="0"
            Background="{DynamicResource SystemChromeMediumColor}"
            BoxShadow="0 2 8 0 #30000000">
      <Grid ColumnDefinitions="*,Auto" Margin="32,24">
        <StackPanel Grid.Column="0" Spacing="8">
          <TextBlock Text="Settings"
                   FontFamily="Cascadia Code"
                   FontSize="32"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource SystemAccentColor}"/>
          <TextBlock Text="Configure your Nexi experience"
                   FontSize="16"
                   Opacity="0.7"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Settings Content -->
    <ScrollViewer Grid.Row="1">
      <StackPanel Margin="32" Spacing="24">
        <!-- AI Model Settings -->
        <Border Background="{DynamicResource SystemChromeMediumColor}"
                CornerRadius="12"
                BoxShadow="0 2 8 0 #30000000">
          <StackPanel Margin="24,20">
            <StackPanel Orientation="Horizontal"
                      Spacing="12"
                      Margin="0,0,0,16">
              <material:MaterialIcon Kind="Brain"
                                   Width="24"
                                   Height="24"
                                   Foreground="{DynamicResource SystemAccentColor}"/>
              <TextBlock Text="{CompiledBinding SelectedModel.Name, StringFormat='{}{0} Model Settings', FallbackValue='AI Model Settings'}"
                       FontSize="20"
                       FontWeight="SemiBold"/>
            </StackPanel>

            <StackPanel Spacing="16">
              <ComboBox SelectedItem="{CompiledBinding SelectedModel}"
                      Width="300"
                      ItemsSource="{CompiledBinding AvailableModels}"
                      HorizontalAlignment="Left">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{CompiledBinding Name}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>

              <CheckBox Content="Use GPU Acceleration (if available)"
                      IsChecked="{CompiledBinding UseGPU}"/>
                      
              <StackPanel Spacing="8">
                <TextBlock Text="Context Size (tokens)"
                         Opacity="0.7"/>
                <NumericUpDown Value="{CompiledBinding ContextSize}"
                             Minimum="512"
                             Maximum="8192"
                             Increment="512"
                             Width="300"
                             HorizontalAlignment="Left"/>
                <TextBlock Text="Larger context allows for longer conversations but uses more memory"
                         Opacity="0.6"
                         FontSize="12"/>
              </StackPanel>
              
              <StackPanel Spacing="8">
                <TextBlock Text="GPU Layer Count"
                         Opacity="0.7"/>
                <NumericUpDown Value="{CompiledBinding GpuLayerCount}"
                             Minimum="0"
                             Maximum="32"
                             Increment="1"
                             Width="300"
                             HorizontalAlignment="Left"/>
                <TextBlock Text="How many layers to offload to GPU (0 for CPU only, higher values use more GPU memory)"
                         Opacity="0.6"
                         FontSize="12"/>
              </StackPanel>
                      
              <TextBlock Text="Note: The Llama 3.2 1B Instruct model must be downloaded from the Models page before it can be used."
                       Opacity="0.7"
                       TextWrapping="Wrap"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Voice Settings -->
        <Border Background="{DynamicResource SystemChromeMediumColor}"
                CornerRadius="12"
                BoxShadow="0 2 8 0 #30000000">
          <StackPanel Margin="24,20">
            <StackPanel Orientation="Horizontal"
                      Spacing="12"
                      Margin="0,0,0,16">
              <material:MaterialIcon Kind="Microphone"
                                   Width="24"
                                   Height="24"
                                   Foreground="{DynamicResource SystemAccentColor}"/>
              <TextBlock Text="Voice Settings"
                       FontSize="20"
                       FontWeight="SemiBold"/>
            </StackPanel>

            <StackPanel Spacing="16">
              <StackPanel Spacing="8">
                <TextBlock Text="Microphone"
                         Opacity="0.7"/>
                <ComboBox SelectedIndex="{CompiledBinding SelectedInputDeviceIndex}"
                        ItemsSource="{CompiledBinding AvailableInputDevices}"
                        Width="300"
                        HorizontalAlignment="Left"/>
                <TextBlock Text="Only connected microphones will be shown in this list"
                         Opacity="0.6"
                         FontSize="12"/>
              </StackPanel>

              <StackPanel Spacing="8">
                <TextBlock Text="Input Sensitivity"
                         Opacity="0.7"/>
                <Slider Value="{CompiledBinding InputSensitivity}"
                        Minimum="0"
                        Maximum="100"
                        Width="300"
                        HorizontalAlignment="Left"/>
                <TextBlock Text="Higher values increase sensitivity for better speech recognition, but may result in more false detections"
                         Opacity="0.6"
                         FontSize="12"
                         TextWrapping="Wrap"/>
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Interface Settings -->
        <Border Background="{DynamicResource SystemChromeMediumColor}"
                CornerRadius="12"
                BoxShadow="0 2 8 0 #30000000">
          <StackPanel Margin="24,20">
            <StackPanel Orientation="Horizontal"
                      Spacing="12"
                      Margin="0,0,0,16">
              <material:MaterialIcon Kind="Palette"
                                   Width="24"
                                   Height="24"
                                   Foreground="{DynamicResource SystemAccentColor}"/>
              <TextBlock Text="Interface Settings"
                       FontSize="20"
                       FontWeight="SemiBold"/>
            </StackPanel>

            <StackPanel Spacing="16">
              <StackPanel Orientation="Horizontal"
                          Spacing="8"
                          VerticalAlignment="Center">
                <TextBlock Text="Theme"
                          VerticalAlignment="Center"
                          Width="120"/>
                <ComboBox SelectedItem="{CompiledBinding SelectedTheme}"
                         Width="200"
                         ItemsSource="{CompiledBinding ThemeOptions}"/>
              </StackPanel>

              <StackPanel Orientation="Horizontal"
                          Spacing="8"
                          VerticalAlignment="Center">
                <TextBlock Text="Accent Color"
                          VerticalAlignment="Center"
                          Width="120"/>
                <CheckBox IsChecked="{CompiledBinding UseSystemAccent}"
                         Content="Use System Accent Color"/>
              </StackPanel>
            </StackPanel>
           </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Nexi.UI.App"
             xmlns:material="using:Material.Icons.Avalonia"
			 xmlns:converters="using:Nexi.UI.Converters"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

  <Application.Resources>
    <converters:BoolToBackgroundConverter x:Key="BoolToBackgroundConverter"/>
    <converters:BoolToAlignmentConverter x:Key="BoolToAlignmentConverter"/>
    <converters:BoolToForegroundConverter x:Key="BoolToForegroundConverter"/>
    <converters:ModelStatusToBrushConverter x:Key="ModelStatusToBrushConverter"/>
    <converters:ModelStatusToDownloadVisibilityConverter x:Key="ModelStatusToDownloadVisibilityConverter"/>
    <converters:ModelStatusToDeleteVisibilityConverter x:Key="ModelStatusToDeleteVisibilityConverter"/>
    <converters:StringEqualityConverter x:Key="StringEqualityConverter"/>
    <converters:EqualityConverter x:Key="EqualityConverter"/>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#A880E4"/>
        <ColorPaletteResources x:Key="Dark" Accent="#A880E4"/>
      </FluentTheme.Palettes>
    </FluentTheme>
    <material:MaterialIconStyles />
    
    <Style Selector="Button.TransparentButton">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    
    <!-- Include styles without x:Key -->
    <StyleInclude Source="/Styles/TransparentButton.axaml"/>
    <StyleInclude Source="/Styles/AccentButton.axaml"/>
  </Application.Styles>
</Application>
